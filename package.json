{
  "name": "cells",
  "version": "0.1.201",
  "private": true,
  "type": "module",
  "author": "Raj Sharma <r@raj.how>",
  "description": "Infinite desktop workspace for terminals, browsers, and agent workflows.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xrehpicx/cells.git"
  },
  "bugs": {
    "url": "https://github.com/xrehpicx/cells/issues"
  },
  "homepage": "https://github.com/xrehpicx/cells",
  "keywords": [
    "electron",
    "terminal",
    "workspace",
    "developer-tools",
    "agents",
    "react"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.6.3",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "pnpm dev:cells",
    "dev:cells": "node scripts/dev-cells.mjs",
    "dev:legacy-electron": "pnpm prepare:terminal-bundles && node scripts/dev.mjs",
    "dev:legacy-electron:raw": "CELLS_DEV_ROOT=\"${CELLS_DEV_ROOT:-$HOME/.cells-dev}\" vite",
    "prepare:terminal-bundles": "pnpm prepare:zellij-bundle && pnpm prepare:tmux-bundle",
    "prepare:terminal-bundles:release": "pnpm prepare:terminal-bundles:release:mac",
    "prepare:terminal-bundles:release:mac": "pnpm prepare:zellij-bundle && pnpm prepare:tmux-bundle:release:mac",
    "prepare:terminal-bundles:release:linux": "CELLS_ZELLIJ_TARGETS=linux-x64,linux-arm64 pnpm prepare:zellij-bundle && pnpm prepare:tmux-bundle:release:linux",
    "prepare:zellij-bundle": "node scripts/prepare-zellij-bundle.mjs",
    "prepare:tmux-bundle": "node scripts/prepare-tmux-bundle.mjs",
    "prepare:tmux-bundle:release:mac": "CELLS_TMUX_TARGETS=darwin-arm64,darwin-x64 CELLS_TMUX_REQUIRE_TARGETS=1 node scripts/prepare-tmux-bundle.mjs",
    "prepare:tmux-bundle:release:linux": "CELLS_TMUX_TARGETS=linux-x64,linux-arm64 CELLS_TMUX_REQUIRE_TARGETS=1 node scripts/prepare-tmux-bundle.mjs",
    "prepare:mcp-server": "CI=true pnpm --dir mcp-server install --frozen-lockfile && pnpm --dir mcp-server build",
    "typecheck:mcp-server": "CI=true pnpm --dir mcp-server install --frozen-lockfile && pnpm --dir mcp-server typecheck",
    "build": "pnpm build:cells",
    "build:cells": "tsc --noEmit --project tsconfig.json && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build --config cells-runtime/vite.cells.config.ts && node scripts/prepare-cells.mjs",
    "build:legacy-electron": "pnpm prepare:mcp-server && pnpm prepare:terminal-bundles && pnpm typecheck:app && pnpm typecheck:legacy-electron && pnpm build:vite",
    "build:vite": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "typecheck": "pnpm typecheck:app",
    "typecheck:app": "tsc --noEmit --project tsconfig.json",
    "typecheck:electron": "tsc --noEmit --project tsconfig.node.json",
    "typecheck:legacy-electron": "pnpm typecheck:electron && pnpm typecheck:mcp-server",
    "test:tmux-session-manager": "pnpm build && node --test scripts/test-tmux-session-manager.mjs",
    "test:zellij-session-manager": "pnpm build && node --test scripts/test-zellij-session-manager.mjs",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps",
    "pack": "pnpm pack:cells",
    "pack:cells": "node scripts/pack-cells.mjs",
    "pack:legacy-electron": "pnpm prepare:mcp-server && pnpm prepare:terminal-bundles:release && pnpm typecheck:app && pnpm typecheck:legacy-electron && pnpm build:vite && electron-builder --dir",
    "release": "pnpm pack:cells",
    "release:legacy-electron": "pnpm prepare:mcp-server && pnpm prepare:terminal-bundles:release && pnpm typecheck:app && pnpm typecheck:legacy-electron && pnpm build:vite && electron-builder --publish always",
    "release:legacy-electron:linux": "pnpm prepare:mcp-server && pnpm prepare:terminal-bundles:release:linux && pnpm typecheck:app && pnpm typecheck:legacy-electron && pnpm build:vite && electron-builder --linux --x64 --arm64 --publish always",
    "release:legacy-electron:local": "pnpm prepare:mcp-server && pnpm prepare:terminal-bundles:release && pnpm typecheck:app && pnpm typecheck:legacy-electron && pnpm build:vite && electron-builder",
    "test:cells:smoke": "node scripts/test-cells-smoke.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'electron/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'electron/**/*.ts'",
    "prepare": "git config core.hooksPath .githooks"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "prettier --write",
    "electron/**/*.ts": "prettier --write"
  },
  "build": {
    "appId": "com.cells.app",
    "productName": "Cells",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*",
      "!resources/vendor/zellij/**/*",
      "!resources/vendor/tmux/**/*"
    ],
    "asar": {
      "smartUnpack": false
    },
    "asarUnpack": [
      "**/node_modules/node-pty/**/*.{node,exe}",
      "**/node_modules/node-pty/**/spawn-helper",
      "**/node_modules/@anthropic-ai/claude-agent-sdk/vendor/**",
      "**/node_modules/koffi/build/**/*.node",
      "**/node_modules/@openai/codex-darwin-*/vendor/**",
      "**/node_modules/@openai/codex-linux-*/vendor/**",
      "**/node_modules/@cursor/sdk-darwin-*/bin/**",
      "**/node_modules/@cursor/sdk-linux-*/bin/**",
      "**/node_modules/@github/copilot/prebuilds/**",
      "**/node_modules/@github/copilot/ripgrep/bin/**",
      "**/node_modules/@github/copilot-darwin-*/copilot",
      "**/node_modules/@github/copilot-linux-*/copilot",
      "**/node_modules/sqlite3/**/*.node"
    ],
    "extraResources": [
      {
        "from": "mcp-server/dist/index.js",
        "to": "mcp-server/dist/index.js"
      },
      {
        "from": "resources/vendor/zellij",
        "to": "vendor/zellij"
      },
      {
        "from": "resources/vendor/tmux",
        "to": "vendor/tmux"
      },
      {
        "from": "src/fonts",
        "to": "vendor/fonts"
      }
    ],
