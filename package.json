    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools",
      "x64ArchFiles": "Contents/Resources/{app.asar.unpacked/node_modules/{node-pty/prebuilds/darwin-{arm64,x64}/{pty.node,spawn-helper},@anthropic-ai/claude-agent-sdk/vendor/{audio-capture/{arm64,x64}-darwin/audio-capture.node,ripgrep/{arm64,x64}-darwin/rg},koffi/build/koffi/darwin_{arm64,x64}/koffi.node,@openai/codex-darwin-{arm64,x64}/vendor/{aarch64,x86_64}-apple-darwin/**/*,@cursor/sdk-darwin-{arm64,x64}/bin/{cursorsandbox,rg},@github/copilot/prebuilds/darwin-{arm64,x64}/{*.node,spawn-helper},@github/copilot/ripgrep/bin/darwin-{arm64,x64}/rg,@github/copilot-darwin-{arm64,x64}/copilot,sqlite3/**/*.node},vendor/zellij/darwin-{arm64,x64}/zellij,vendor/tmux/darwin-{arm64,x64}/tmux}",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Development",
      "maintainer": "Raj Sharma <r@raj.how>",
      "synopsis": "Infinite desktop workspace for terminals, browsers, and agent workflows.",
      "description": "Cells is a desktop workspace for arranging terminals, browser panes, and agent workflows on an infinite canvas.",
      "executableName": "cells",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-atk",
        "libuuid",
        "libsecret"
      ]
    },
    "dmg": {
      "title": "Cells",
      "iconSize": 80,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
